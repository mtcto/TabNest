<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      InvariantGlobalization 必须保持 false。

      曾为压缩常驻内存开启过，结果 WPF 一显示窗口就崩：它的字体缓存
      （MS.Internal.FontCache.MajorLanguages）在静态构造里执行 new CultureInfo("en")，
      invariant 模式下直接抛 CultureNotFoundException。
      这个坑很隐蔽 —— 常驻层不碰 WPF，所以要等用户第一次打开设置中心才会暴露。

      UseSystemResourceKeys 同理保持 false：它会把异常消息压成资源键
      （"Argument_CultureNotSupportedInInvariantMode" 而非可读文本），
      而可解释的诊断正是本产品的卖点，为省几百 KB 牺牲它不划算。
    -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>

    <!-- 性能：常驻托盘进程用工作站 GC，避免 ServerGC 的多堆内存开销 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <!-- P/Invoke 必须走源生成的 LibraryImport -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Company>TabNest</Company>
    <Product>TabNest</Product>
    <Copyright>Copyright (c) 2026 TabNest Contributors</Copyright>
    <Version>0.1.3</Version>
    <NeutralLanguage>zh-CN</NeutralLanguage>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      刻意不豁免 CA1416（平台兼容性）：TFM 已精确到 net10.0-windows10.0.19041.0，
      调用更高版本 API 时必须报错，由我们显式做 OS 版本判定后再降级，
      而不是靠全局豁免把问题藏起来。
    -->
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>

  <!-- 测试项目放宽：断言与测试数据不适用生产级分析规则 -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
